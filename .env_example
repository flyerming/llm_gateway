# docker compose 会自动加载同目录下的 .env，不要把它提交到仓库。

# ---- LiteLLM 网关 ----
# LITELLM_SALT_KEY 一旦库里有了数据就永远不能改：它用来加密存储的模型凭据，
# 改了之后那些记录就解不开了。请单独备份这个值。
LITELLM_MASTER_KEY=sk-*****************************
LITELLM_SALT_KEY=*******************

# ---- Postgres ----
# 重要：POSTGRES_PASSWORD 只在数据目录首次初始化时生效。现有的 postgres_data 卷
# 是用 "litellm" 初始化的，所以这里必须保持 litellm，否则 litellm 会连不上数据库
# （而 pg_isready 健康检查不校验密码，表现为容器健康但运行时报认证失败）。
# 要换成强密码，得走一遍导出→删卷→重建→导入，步骤见 network/README.md。
POSTGRES_PASSWORD=sk-*****************************

# ---- 节点控制台 ----
CONSOLE_USER=admin
CONSOLE_PASSWORD=*********

# ---- CLIProxyAPI ----
# 数据面 API key：LiteLLM 的模型 base_url 指向 cli-proxy-api:8317/v1 时使用。
# 下面的值是本地生成的随机长字符串；如需轮换，请同时更新两个服务并重启。
CLIPROXY_API_KEY=******************
# 管理面 key：仅由 proxy-console 调用 /v0/management 使用。
CLIPROXY_MANAGEMENT_KEY=********

# ---- 宿主机 CA（HTTPS 出网，必填）----
# Debian/Ubuntu:
HOST_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# RHEL/CentOS/AlmaLinux 请改成：
# HOST_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
# 如果服务器使用企业 HTTPS 中间人代理，需把企业根 CA 加入该 bundle；
# 不要通过 skip-cert-verify 关闭证书校验。

# SearXNG 搜索：settings.yml 里的 server.secret_key 取这个值。
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
SEARXNG_SECRET=***********************************
# 搜索引擎出网走的代理。留空或删掉则用 compose 里的默认值 http://proxy:7890；
# 要直连请改 searxng/settings.yml 注释掉 outgoing.proxies。
SEARXNG_PROXY=http://proxy:7890

# MCP 搜索服务的 Bearer token。三个客户端（codex CLI / VSCode Codex 插件 /
# VSCode Claude Code）以及 DeepSeek Harness 都要带这个值：DSH 的 home 补丁会
# 用它去连 compose 内的 searxng-mcp:8090，作为它的联网搜索工具。生成方式：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_SEARXNG_TOKEN=************************
SEARXNG_IMAGE=searxng/searxng:2026.9.17-3accbaca7
MCP_SEARXNG_IMAGE=isokoliuk/mcp-searxng:2.3
# ---- MCP 搜索后端（searxng-mcp）的 Host/Origin 白名单 ----
# 用 compose 服务名，不是 IP：LiteLLM 以容器身份经 compose 网络来连，Host 头就是
# searxng-mcp:8090。服务名在任何环境下都一样，所以这里不需要随机器/IP 改动。
# ★ 这两个值必须和 searxng/register_mcp.py 里注册的 URL 同源 —— 不一致时
#   网关的 MCP 路由会 403，而 searxng-mcp 的 /health 照样是绿的。
#   register_mcp.py 每次运行都会核对，对不上会报警。
MCP_SEARXNG_ALLOWED_HOSTS=searxng-mcp:8090
MCP_SEARXNG_ALLOWED_ORIGINS=http://searxng-mcp:8090

# ---- DeepSeek Harness 多用户 Agent ----
# 上游源码目录，使用相对路径（相对 deepseek-harness/ 构建上下文）。
# Docker build 直接 COPY 这个目录，不再在构建阶段 git clone GitHub；
# 迁移环境时把官方原始下载的源码放到同名目录下即可。
DSH_SRC_DIR=deepseek-harness-dsh-v0.1.5-rc.2-git
# 上面目录对应官方 tag 的 commit。源码目录里的 .git 不进入镜像，
# 构建元数据（页面版本号/commit）靠这个值补齐。
DSH_COMMIT_HASH=fb2c4b9e698e30edb738bca4cf0618587db7d203
# 建议不要继续使用 admin/控制台密码，改成单独的 Agent 入口账号。
DSH_BOOTSTRAP_USER=mengweiming
DSH_BOOTSTRAP_PASSWORD=************************
# 只作为每个新用户第一次打开页面时的默认模型清单；用户之后可在网页中修改。
# 必须与 LiteLLM 对外的 model_name 一致，逗号分隔。
DSH_DEFAULT_MODEL_IDS=deepseek-v4.1-flash,glm-5.3-flash,qwen3-5-397b

# ---- 轻量 Compose（可选）----
# docker-compose.light.yml 不经过 LiteLLM，DSH 直接调用
# http://cli-proxy-api:8317/v1。这里填写 CLIProxyAPI /v1/models 返回的真实 id，
# 逗号分隔；不要直接照搬上面的 LiteLLM 模型名，除非两边确实一致。
DSH_LIGHT_MODEL_IDS=<从 CLIProxyAPI /v1/models 选择真实模型 ID>
# 如果镜像在其他机器构建后通过 docker save/docker load 迁移，可设置为导入时的镜像 tag。
# DSH_IMAGE=litellm-light/deepseek-harness:0.1.5-rc.2
# 如果全功能 Compose 已经构建过 DSH，也可以直接复用它：
# DSH_IMAGE=litellm-0914-deploy-deepseek-harness:latest
# 轻量栈默认使用 8788（控制台）和 3081（Harness），可与全功能栈并行。
# LIGHT_CONSOLE_PORT=8788
# LIGHT_DSH_PORT=3081
# LIGHT_PROJECT_NAME=litellm-light

# 用户文件隔离：每个用户分配一个专属容器内 UID（从 DSH_BASE_UID 起顺序分配），
# 用该 UID 启动他自己的 `dsh web`。这是文件隔离唯一可靠的手段 —— 同 UID 下
# chmod 挡不住任何东西（root 直接无视权限位）。UID 映射持久化在 dsh_auth 卷里。
# 一般不需要改；只有和宿主/其他服务 UID 冲突时才调整这两个值。
# DSH_BASE_UID=20000
# DSH_UID_CEILING=60000
# 逃生开关：降权启动出问题时临时设为 0，退回「所有用户共用一个 root 进程」的
# 旧行为（此时用户目录之间**没有**文件隔离，仅用于排障）。
# DSH_ISOLATE_USERS=1

# 命令执行的沙箱后端。Linux 下 DSH 的沙箱链是 bwrap → landlock，默认
# `workspace-write`（命令在文件沙箱里跑，越界要人工审批）。但两者在
# AlmaLinux/CentOS/RHEL 8（内核 4.18）上都不可用 —— bwrap 需要 user namespace
# （Docker 默认 seccomp 拦 CLONE_NEWUSER），landlock 需要内核 ≥5.13 —— 于是 DSH
# 无法沙箱化命令，**每次工具调用都弹审批**。把它设成 danger-full-access 可关掉
# 审批（文件沙箱同时关闭，但上面的每用户 UID 隔离不受影响，见 README §9.5）。
# 若宿主内核 ≥5.13 且启用了 Landlock，改回 workspace-write 即可恢复文件沙箱。
DSH_PERMISSION_MODE=danger-full-access

# 私有网关模型的思考强度线协议（compat.thinkingFormat）。默认 openai —— 对
# LiteLLM 以 OpenAI 兼容方式转发 reasoning_effort 的场景最通用；若上游按
# DeepSeek 风格处理，改为 deepseek。改动后重建/重启 deepseek-harness 生效。
# DSH_MODEL_REASONING_FORMAT=openai

# Docker 构建镜像时 pnpm/corepack 下载依赖使用的 npm registry。
# 国内服务器默认走 npmmirror；能直连 npmjs 或使用私有 Nexus/Verdaccio 时改这里，
# 例如：NPM_REGISTRY=https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com

# pnpm 并发下载连接数。默认 16；国内网络/受限出口下大量并发 tarball 下载
# 容易被中间设备 RST，日志表现为 `GET ... error (23). Will retry`。
# 默认已降到 4；网络好可调回 8~16，特别差可降到 1~2。
NPM_FETCH_CONCURRENCY=4

# 构建期代理（可选，通常不需要）。
# docker compose build 现在用 `network: host` 构建，直接复用宿主机网络路径，
# 因此宿主机能出网时构建一般也能出网。只有宿主机自身要靠代理才能出网时才需要
# 打开下面两项。配合 network: host，代理地址从构建容器视角就是宿主机，
# 所以可以写 127.0.0.1。
# DSH_BUILD_HTTP_PROXY=http://127.0.0.1:7890
# DSH_BUILD_HTTPS_PROXY=http://127.0.0.1:7890
# 如果 Debian 官方源不可达，可同时指定 APT 镜像；两个地址要成对设置。
# DSH_APT_MIRROR=http://mirrors.aliyun.com/debian
# DSH_APT_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security
